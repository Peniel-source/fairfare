# Copy to backend/.env and fill in. Never commit backend/.env.
#   cp .env.example .env && chmod 600 .env
# Get the real values from the team privately (password manager or one-to-one),
# never through the group chat, a PR, an issue or a screenshot.

# Protects the /payments admin endpoints. Must be at least 32 characters.
# Generate with: openssl rand -hex 32
ADMIN_KEY=

# Firebase Admin. From Firebase console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# One line, in double quotes, with \n where the line breaks are.
FIREBASE_PRIVATE_KEY=

# Optional
# PORT=3000
# Development only: use the Firestore emulator instead of the real database.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# Development only, emulator only: approve every pending Pass automatically.
# PAYMENTS_AUTO_APPROVE=true
# Where the payments admin script sends requests (default http://localhost:3000).
# PAYMENTS_API_URL=
